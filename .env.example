# Everything is optional for local development: without these, NightPass uses an embedded
# database in ./.data and built-in development keys.

# Postgres connection string (Neon, Supabase, RDS, local…). Leave empty to use embedded PGlite.
DATABASE_URL=

# Ed25519 private key (64 hex chars) that signs student passes. Generate with: npm run keys
QR_SIGNING_KEY=

# Secret for signing session cookies. Generate with: npm run keys
AUTH_SECRET=

# One-click demo accounts and the "Reset demo data" button. Set to false in production.
DEMO_MODE=true
